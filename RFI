    if (!isIkeaPage) {
        return { url: url.href, name: null, widthMeters: null, heightMeters: null, depthMeters: null };
    }

    let response;
    try {
        response = await fetch(url.href);
    } catch {
        throw new Error("IKEA blocked the page request from this browser. Right-click the product photo, choose “Copy image address”, and paste that instead.");
    }
    if (!response.ok) throw new Error(`Couldn't open the IKEA product page (HTTP ${response.status}).`);

    const documentPage = new DOMParser().parseFromString(await response.text(), "text/html");
    const slug = url.pathname.split("/").filter(Boolean).pop().replace(/-\d+$/, "").toLowerCase();
