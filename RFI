        return [
            ["plain background", 5], ["white background", 5], ["isolated", 4], ["cutout", 4],
            ["elegant", 3], ["clear", 1], ["with", 1]
        ].reduce((total, [cue, weight]) => total + (text.includes(cue) ? weight : 0), 0) -
        (/\b(room|bedroom|kitchen|office|table|surrounded|interior|lifestyle)\b|red wine stands/i.test(text) ? 10 : 0);
    };
    const cleanImage = pool.length
        ? pool.reduce((best, candidate) => imageScore(candidate) > imageScore(best) ? candidate : best, pool[0])
        : null;
    const openGraphImage = documentPage.querySelector('meta[property="og:image"]')?.content;
    const image = transparentImage || cleanImage || (openGraphImage ? { image: openGraphImage } : null);
    if (!image) throw new Error("No product image was found on that IKEA page.");

    const info = getIkeaProductInfo(documentPage);
    const ogTitle = documentPage.querySelector('meta[property="og:title"]')?.content;
    return {
        url: new URL(image.image, url.href).href,
        name: info?.name || (ogTitle ? ogTitle.split(/\s[-|–]\s/)[0].trim() : null),
        widthMeters: info?.widthMeters ?? null,
        heightMeters: info?.heightMeters ?? null,
        depthMeters: info?.depthMeters ?? null
    };
}

/* ======================= Background removal (on-device) ======================= */
let runtimePromise = null, sessionPromise = null;
function loadOnnxRuntime() {
    if (window.ort) return Promise.resolve(window.ort);
    if (!runtimePromise) {
        runtimePromise = new Promise((resolve, reject) => {
            const script = document.createElement("script");
            script.src = "https://cdn.jsdelivr.net/npm/onnxruntime-web@1.21.0/dist/ort.min.js";
            script.onload = () => {
                if (window.ort) resolve(window.ort);
                else { runtimePromise = null; reject(new Error("Couldn't start the background remover.")); }
            };
            script.onerror = () => { runtimePromise = null; reject(new Error("Couldn't download the background remover.")); };
            document.head.appendChild(script);
        });
    }
    return runtimePromise;
}
async function getBackgroundSession() {
    const ort = await loadOnnxRuntime();
    if (!sessionPromise) {
        sessionPromise = ort.InferenceSession.create(
            "https://huggingface.co/nfa04/u2netp-onnx/resolve/8e72726f035efc3d1918c96b020d536f2b69ba0c/u2netp.onnx",
            { executionProviders: ["wasm"] }
        ).catch(error => { sessionPromise = null; throw error; });
    }
    return { ort, session: await sessionPromise };
}
async function removeBackground(url) {
    const image = await loadImage(url, true);
    if (!sessionPromise) toast("Loading the background remover (about 5 MB, first time only)…", { sticky: true });
    const { ort, session } = await getBackgroundSession();
    toast("Removing the background on this device…", { sticky: true });

    const modelSize = 320;
    const inputCanvas = document.createElement("canvas");
    inputCanvas.width = inputCanvas.height = modelSize;
    const inputContext = inputCanvas.getContext("2d", { willReadFrequently: true });
    inputContext.fillStyle = "#fff";
    inputContext.fillRect(0, 0, modelSize, modelSize);
    const scale = Math.min(modelSize / image.naturalWidth, modelSize / image.naturalHeight);
    const width = image.naturalWidth * scale, height = image.naturalHeight * scale;
    const left = (modelSize - width) / 2, top = (modelSize - height) / 2;
    inputContext.drawImage(image, left, top, width, height);

    const pixels = inputContext.getImageData(0, 0, modelSize, modelSize).data;
    const planeSize = modelSize * modelSize;
    const input = new Float32Array(planeSize * 3);
    for (let i = 0; i < planeSize; i++) {
        input[i] = (pixels[i * 4] / 255 - 0.485) / 0.229;
        input[planeSize + i] = (pixels[i * 4 + 1] / 255 - 0.456) / 0.224;
        input[planeSize * 2 + i] = (pixels[i * 4 + 2] / 255 - 0.406) / 0.225;
    }
    const result = await session.run({
        [session.inputNames[0]]: new ort.Tensor("float32", input, [1, 3, modelSize, modelSize])
    });
    const mask = result[session.outputNames[0]].data;
    let min = Infinity, max = -Infinity;
    for (const value of mask) { min = Math.min(min, value); max = Math.max(max, value); }

    const maskCanvas = document.createElement("canvas");
    maskCanvas.width = maskCanvas.height = modelSize;
    const maskContext = maskCanvas.getContext("2d");
    const maskPixels = maskContext.createImageData(modelSize, modelSize);
    for (let i = 0; i < mask.length; i++) {
        const alpha = Math.round(Math.max(0, Math.min(1, (mask[i] - min) / (max - min || 1))) * 255);
        maskPixels.data[i * 4] = maskPixels.data[i * 4 + 1] = maskPixels.data[i * 4 + 2] = 255;
        maskPixels.data[i * 4 + 3] = alpha;
    }
    maskContext.putImageData(maskPixels, 0, 0);

    const outputCanvas = document.createElement("canvas");
    outputCanvas.width = image.naturalWidth;
    outputCanvas.height = image.naturalHeight;
    const outputContext = outputCanvas.getContext("2d", { willReadFrequently: true });
    outputContext.drawImage(image, 0, 0);
    outputContext.globalCompositeOperation = "destination-in";
    outputContext.drawImage(maskCanvas, left, top, width, height, 0, 0, image.naturalWidth, image.naturalHeight);

    const out = outputContext.getImageData(0, 0, outputCanvas.width, outputCanvas.height).data;
    let minX = outputCanvas.width, minY = outputCanvas.height, maxX = -1, maxY = -1;
    for (let y = 0; y < outputCanvas.height; y++) {
        for (let x = 0; x < outputCanvas.width; x++) {
            if (out[(y * outputCanvas.width + x) * 4 + 3] > 16) {
                if (x < minX) minX = x;
                if (x > maxX) maxX = x;
                if (y < minY) minY = y;
                if (y > maxY) maxY = y;
            }
        }
    }
    if (maxX < minX || maxY < minY) throw new Error("The background remover couldn't find the product.");
    const cropW = maxX - minX + 1, cropH = maxY - minY + 1;
    return { src: imageToDataUrl(outputCanvas, cropW, cropH, minX, minY), aspect: cropH / cropW };
}

