function parseMeasurementMeters(value) {
    const match = /^([\d\s,./]+)\s*(mm|cm|m|inches|inch|in|["″])$/i.exec(String(value || "").trim());
    if (!match) return null;
    const fraction = /^(\d+(?:[.,]\d+)?)\s+(\d+)\/(\d+)$/.exec(match[1].trim());
    const amount = fraction
        ? Number(fraction[1].replace(",", ".")) + Number(fraction[2]) / Number(fraction[3])
        : Number(match[1].replace(",", "."));
    if (!Number.isFinite(amount) || amount <= 0) return null;
    const unit = match[2].toLowerCase();
    const multiplier = unit === "mm" ? 0.001 : unit === "cm" ? 0.01 : unit === "m" ? 1 : 0.0254;
    return amount * multiplier;
}
function getIkeaProductInfo(documentPage) {
    for (const script of documentPage.querySelectorAll('script[type="application/ld+json"]')) {
        let data;
        try { data = JSON.parse(script.textContent); } catch { continue; }
        const products = Array.isArray(data) ? data : data["@graph"] || [data];
        const product = products.find(entry =>
            entry["@type"] === "Product" ||
            (Array.isArray(entry["@type"]) && entry["@type"].includes("Product")));
        if (!product) continue;
        return {
            name: typeof product.name === "string" ? product.name.trim() : null,
            widthMeters: parseMeasurementMeters(product.width),
            heightMeters: parseMeasurementMeters(product.height),
            depthMeters: parseMeasurementMeters(product.depth)
