        const key = new URL(image).pathname;
        const candidate = { description: imageElement.alt || "", image, resolution: bestSource.resolution };
        const previous = allCandidates.get(key);
        if (!previous || candidate.resolution > previous.resolution) allCandidates.set(key, candidate);
    }

    const candidates = [...allCandidates.values()];
    const productCandidates = candidates.filter(({ image }) =>
        new URL(image).pathname.toLowerCase().includes(`/images/products/${slug}__`));
    const pool = productCandidates.length ? productCandidates : candidates;
