ROOMFIT_PORT=3000
# 0.0.0.0 lets phones and other computers on your network open Room For Improvement and generate 3D models.
# Use 127.0.0.1 to keep it to this computer only.
ROOMFIT_HOST=0.0.0.0
# Password other devices must enter (any username). Leave empty to disable.
ROOMFIT_PASSWORD=
ROOMFIT_AUTOSTART_TRELLIS=true

# Optional SSH tunnel to a remote TRELLIS API. The remote API must already be running.
TRELLIS_SSH_TARGET=
TRELLIS_SSH_PORT=22
TRELLIS_SSH_IDENTITY_FILE=
TRELLIS_REMOTE_API_PORT=7861
TRELLIS_API_URL=http://127.0.0.1:7861

# Optional structured-output LLM endpoint; it must return the product object matching the supplied schema.
ROOMFIT_LLM_URL=
ROOMFIT_LLM_TOKEN=
